NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Optional custom SQLite path. Defaults to ./instance/disruptioniq.db
DATABASE_PATH=
# Set a webhook secret for external carrier webhook requests; mandatory in production.
WEBHOOK_SECRET=
# Development bootstrap overrides only. Never reuse demo passwords in production.
DEMO_HUB_PASSWORD=
DEMO_RISK_PASSWORD=
DEMO_RECOVERY_PASSWORD=
DEMO_CUSTOMER_PASSWORD=

# Optional server-side explanation provider. Leave LLM_PROVIDER=none for deterministic-only mode.
# Supported providers: none, openai-compatible, gemini
LLM_PROVIDER=none
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=8
LLM_CACHE_TTL=300
