# DisruptionIQ Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit real secrets or credentials to version control.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-env-to-a-secure-random-string

# Database Configuration (SQLite with Flask-SQLAlchemy)
DATABASE_URL=sqlite:///instance/disruptioniq.db

# Optional AI / LLM Configuration
# Core disruption handling, risk rules, and inventory calculations remain deterministic.
# When LLM_API_KEY is empty or LLM_PROVIDER is 'none', the app uses local template-based fallbacks.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
